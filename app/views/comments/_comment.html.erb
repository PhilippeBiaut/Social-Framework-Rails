<div id="<%= dom_id(comment) %>" class="flex gap-3">
  <%= avatar_for comment.user, size: "size-9", text: "text-xs" %>
  <div class="flex-1">
    <div class="card px-4 py-2.5">
      <div class="flex items-center justify-between gap-2">
        <div class="flex flex-wrap items-baseline gap-x-2">
          <%= link_to comment.user.display_name, user_path(comment.user), class: "text-sm font-semibold text-gray-900 hover:underline dark:text-white" %>
          <span class="text-xs text-gray-400">@<%= comment.user.username %></span>
          <%= timestamp comment.created_at %>
        </div>
        <% if comment.user == current_user %>
          <%= button_to post_comment_path(comment.post, comment), method: :delete,
                form: { data: { turbo_confirm: "Delete this comment?" } },
                class: "text-gray-300 hover:text-red-500" do %>
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          <% end %>
        <% end %>
      </div>
      <p class="mt-0.5 whitespace-pre-wrap break-words text-sm text-gray-800 dark:text-gray-100"><%= comment.body %></p>
    </div>
  </div>
</div>
