<% content_for :title, "Join Social" %>

<div class="w-full max-w-md">
  <div class="mb-6 text-center">
    <span class="mx-auto mb-3 grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-indigo-600 to-fuchsia-600 text-white">
      <svg class="size-7" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a4 4 0 100 8 4 4 0 000-8zM4 15a6 6 0 1112 0v1a1 1 0 01-1 1H5a1 1 0 01-1-1v-1z"/></svg>
    </span>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Create your account</h1>
    <p class="text-sm text-muted">Join the conversation.</p>
  </div>

  <%= form_with model: @user, url: registration_path, class: "card space-y-4 p-6",
        data: { controller: "password-visibility password-strength" } do |f| %>

    <% if @user.errors.any? %>
      <div class="rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-900/40 dark:text-red-300">
        <ul class="list-inside list-disc">
          <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :email_address, "Email", class: "label" %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
            class: "input", placeholder: "you@example.com" %>
    </div>

    <div>
      <%= f.label :username, class: "label" %>
      <div class="flex">
        <span class="inline-flex items-center rounded-l-lg border border-r-0 border-gray-300 bg-gray-100 px-3 text-sm text-gray-600 dark:border-gray-600 dark:bg-gray-600 dark:text-gray-300">@</span>
        <%= f.text_field :username, required: true, autocomplete: "off",
              class: "input !rounded-l-none", placeholder: "yourname" %>
      </div>
    </div>

    <div>
      <%= f.label :name, "Display name", class: "label" %>
      <%= f.text_field :name, class: "input", placeholder: "Optional" %>
    </div>

    <div>
      <%= f.label :password, class: "label" %>
      <div class="relative">
        <%= f.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
              class: "input pr-10",
              data: { password_visibility_target: "field", password_strength_target: "input",
                      action: "input->password-strength#update" } %>
        <%= render "shared/password_toggle" %>
      </div>
      <div class="mt-2">
        <div class="h-1.5 w-full rounded-full bg-gray-200 dark:bg-gray-600">
          <div data-password-strength-target="bar" class="h-1.5 w-0 rounded-full bg-gray-200 transition-all dark:bg-gray-600"></div>
        </div>
        <p class="mt-1 text-xs text-muted" data-password-strength-target="label"></p>
      </div>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "label" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "input", placeholder: "Repeat your password" %>
    </div>

    <%= f.submit "Create account", class: "btn-primary w-full cursor-pointer" %>
  <% end %>

  <p class="mt-5 text-center text-sm text-muted">
    Already have an account?
    <%= link_to "Sign in", new_session_path, class: "font-semibold text-indigo-600 hover:underline dark:text-indigo-400" %>
  </p>
</div>
