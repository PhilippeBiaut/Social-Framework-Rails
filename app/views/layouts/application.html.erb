<!DOCTYPE html>
<html lang="en" data-controller="theme">
  <head>
    <title><%= content_for(:title) || "Social Framework" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Social Framework">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Avoid a flash of the wrong theme before Stimulus connects. %>
    <%= javascript_tag nonce: true do %>
      (function () {
        var saved = localStorage.getItem("theme");
        var dark = saved ? saved === "dark"
                         : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    <% end %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased dark:bg-gray-900 dark:text-gray-100">
    <%= render "shared/flash" %>

    <% if authenticated? %>
      <%= render "shared/navbar" %>
      <main class="mx-auto max-w-2xl px-4 pb-24 pt-6 sm:pt-8">
        <%= yield %>
      </main>
    <% else %>
      <main class="flex min-h-screen items-center justify-center px-4 py-10">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
