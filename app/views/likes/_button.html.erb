<% liked = post.liked_by?(current_user) %>
<div id="post_<%= post.id %>_like" class="inline-flex"
     data-controller="like" data-like-liked-value="<%= liked %>">
  <%= button_to post_like_path(post), method: liked ? :delete : :post,
        class: "btn-ghost !px-2.5 text-muted",
        data: { action: "like#toggle" } do %>
    <svg data-like-target="icon"
         class="size-5 transition-transform duration-150 <%= 'fill-current text-red-500' if liked %>"
         fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
    </svg>
    <span data-like-target="count"><%= post.likes.size %></span>
  <% end %>
</div>
