<% content_for :title, "Reset password" %>

<div class="w-full max-w-md">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Forgot your password?</h1>
    <p class="text-sm text-muted">We'll email you a reset link.</p>
  </div>

  <%= form_with url: passwords_path, class: "card space-y-4 p-6" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address], placeholder: "you@example.com", class: "input" %>
    </div>
    <%= form.submit "Email reset instructions", class: "btn-primary w-full cursor-pointer" %>
  <% end %>

  <p class="mt-5 text-center text-sm text-muted">
    <%= link_to "Back to sign in", new_session_path, class: "font-semibold text-indigo-600 hover:underline dark:text-indigo-400" %>
  </p>
</div>
