<% content_for :title, title %>

<%= link_to user_path(@user), class: "mb-4 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white" do %>
  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
  <%= @user.display_name %>
<% end %>

<h1 class="mb-4 text-xl font-bold text-gray-900 dark:text-white"><%= title %></h1>

<div class="space-y-3">
  <% if @users.any? %>
    <%= render partial: "users/user_row", collection: @users, as: :user_row %>
  <% else %>
    <p class="card p-6 text-center text-sm text-gray-500">Nobody here yet.</p>
  <% end %>
</div>
