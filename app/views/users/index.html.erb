<% content_for :title, "People" %>

<h1 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Discover people</h1>

<%= form_with url: users_path, method: :get, data: { controller: "autosubmit", turbo_frame: "people", turbo_action: "advance" } do %>
  <div class="relative mb-4">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-gray-400">
      <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
    </span>
    <%= text_field_tag :q, params[:q], placeholder: "Search by name or @username",
          autocomplete: "off",
          data: { action: "input->autosubmit#submit" },
          class: "input !pl-10" %>
  </div>
<% end %>

<%= turbo_frame_tag "people" do %>
  <div class="space-y-3">
    <% if @users.any? %>
      <%= render partial: "users/user_row", collection: @users, as: :user_row %>
    <% else %>
      <p class="card p-6 text-center text-sm text-gray-500">No one matches “<%= params[:q] %>”.</p>
    <% end %>
  </div>
<% end %>
