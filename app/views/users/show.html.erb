<% content_for :title, @user.display_name %>

<div class="card overflow-hidden">
  <div class="h-28 bg-gradient-to-r from-indigo-500 via-purple-500 to-fuchsia-500"></div>
  <div class="px-4 pb-4">
    <div class="-mt-12 flex items-end justify-between">
      <div class="rounded-full border-4 border-white dark:border-gray-800">
        <%= avatar_for @user, size: "size-24", text: "text-2xl", link: false, ring: false %>
      </div>
      <div class="mb-1 flex items-center gap-2">
        <button type="button" data-controller="clipboard"
                data-clipboard-text-value="<%= user_url(@user) %>"
                data-action="clipboard#copy" class="btn-outline !px-2.5" title="Copy profile link">
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg>
          <span data-clipboard-target="label" class="text-sm">Share</span>
        </button>
        <%= render "follows/button", user: @user %>
      </div>
    </div>

    <div class="mt-2">
      <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= @user.display_name %></h1>
      <p class="text-sm text-gray-400">@<%= @user.username %></p>
      <% if @user.bio.present? %>
        <p class="mt-2 whitespace-pre-wrap text-gray-700 dark:text-gray-200"><%= @user.bio %></p>
      <% end %>
    </div>

    <div class="mt-3 flex gap-5 text-sm text-gray-500">
      <span><span class="font-semibold text-gray-900 dark:text-white"><%= @user.posts.size %></span> Posts</span>
      <%= link_to following_user_path(@user), class: "hover:underline" do %>
        <span class="font-semibold text-gray-900 dark:text-white"><%= @user.following.size %></span> Following
      <% end %>
      <%= link_to followers_user_path(@user), class: "hover:underline" do %>
        <%= render "users/followers_count", user: @user %> Followers
      <% end %>
    </div>
  </div>
</div>

<%# Posts / Likes. Only the active tab is rendered: a post an author liked
    themselves would otherwise appear in both panels with the same element ids. %>
<div class="mt-6">
  <div class="flex border-b border-gray-200 text-sm font-medium dark:border-gray-700" role="tablist">
    <% { "posts" => "Posts", "likes" => "Likes" }.each do |value, label| %>
      <%= link_to label, user_path(@user, tab: value), role: "tab",
            "aria-selected": (@tab == value).to_s,
            class: "-mb-px border-b-2 px-4 py-2.5 #{@tab == value ?
              'border-indigo-600 text-indigo-600 dark:text-indigo-400' :
              'border-transparent text-gray-500 hover:text-gray-900 dark:hover:text-white'}" %>
    <% end %>
  </div>

  <div class="mt-4 space-y-4">
    <% if @posts.any? %>
      <%= render partial: "posts/post", collection: @posts %>
    <% else %>
      <p class="card p-6 text-center text-sm text-gray-500">
        <%= @tab == "likes" ? "No liked posts yet." : "#{@user.display_name} hasn't posted yet." %>
      </p>
    <% end %>
  </div>
</div>
