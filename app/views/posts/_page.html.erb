<%# One page of a post list — used by the feed and by a profile. The lazy nested
    frame gives infinite scroll for free: Turbo loads it when it scrolls in.

    `next_page_url` is a lambda taking the cursor, so the caller decides whether
    the next page comes from /posts or /users/:username.

    The frame carries `block space-y-4` itself: <turbo-frame> is inline by
    default, so the container's spacing would apply to the frame instead of to
    the posts inside it, leaving the cards flush against each other. %>
<%= turbo_frame_tag "page_#{before || 'first'}", class: "block space-y-4" do %>
  <%= render partial: "posts/post", collection: posts %>

  <% if has_more %>
    <%= turbo_frame_tag "page_#{posts.last.id}",
          src: next_page_url.call(posts.last.id),
          loading: :lazy, class: "block space-y-4" do %>
      <div class="flex justify-center py-6">
        <svg class="size-6 animate-spin text-indigo-500" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
      </div>
    <% end %>
  <% end %>
<% end %>
