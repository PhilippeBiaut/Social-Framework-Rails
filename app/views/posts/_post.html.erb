<article id="<%= dom_id(post) %>" class="card p-4">
  <header class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-3">
      <%= avatar_for post.user %>
      <div class="leading-tight">
        <%= link_to post.user.display_name, user_path(post.user), class: "font-semibold text-gray-900 hover:underline dark:text-white" %>
        <span class="text-sm text-muted">@<%= post.user.username %></span>
        <div><%= timestamp post.created_at %></div>
      </div>
    </div>

    <% if post.user == current_user %>
      <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
        <button type="button" data-dropdown-target="button" data-action="dropdown#toggle" class="rounded-lg p-1.5 text-muted hover:bg-gray-100 dark:hover:bg-gray-700" aria-label="Post menu">
          <svg class="size-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/></svg>
        </button>
        <div data-dropdown-target="menu" class="absolute right-0 z-30 mt-1 hidden w-40 rounded-xl border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-700 dark:bg-gray-800">
          <%= button_to post_path(post), method: :delete,
                form: { data: { turbo_confirm: "Delete this post?" } },
                class: "block w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-gray-100 dark:text-red-400 dark:hover:bg-gray-700" do %>
            Delete post
          <% end %>
        </div>
      </div>
    <% end %>
  </header>

  <div class="mt-3">
    <p class="whitespace-pre-wrap break-words text-gray-800 dark:text-gray-100"><%= post.body %></p>

    <% if post.image.attached? %>
      <div class="mt-3" data-controller="modal">
        <button type="button" data-action="modal#open" class="block w-full">
          <%= image_tag post.image, alt: "Post image", class: "max-h-96 w-full rounded-xl object-cover" %>
        </button>
        <div data-modal-target="dialog" data-action="click->modal#backdrop"
             class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/80 p-4">
          <%= image_tag post.image, alt: "Post image", class: "max-h-[90vh] max-w-full rounded-lg shadow-2xl" %>
          <button type="button" data-action="modal#close" class="absolute right-4 top-4 grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label="Close">
            <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <footer class="mt-3 flex items-center gap-1 border-t border-gray-100 pt-2 dark:border-gray-700">
    <%= render "likes/button", post: post %>

    <%= link_to post_path(post), class: "btn-ghost !px-2.5 text-muted", data: { turbo_frame: "_top" } do %>
      <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/></svg>
      <span><%= post.comments.size %></span>
    <% end %>

    <button type="button" data-controller="clipboard"
            data-clipboard-text-value="<%= post_url(post) %>"
            data-action="clipboard#copy"
            class="btn-ghost !px-2.5 text-muted ml-auto">
      <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/></svg>
      <span data-clipboard-target="label" class="text-sm">Share</span>
    </button>
  </footer>
</article>
