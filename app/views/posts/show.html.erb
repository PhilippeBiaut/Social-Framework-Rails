<% content_for :title, "Post by #{@post.user.display_name}" %>

<h1 class="sr-only">Post by <%= @post.user.display_name %></h1>

<%= link_to root_path, class: "mb-4 inline-flex items-center gap-1 text-sm text-muted hover:text-gray-900 dark:hover:text-white" do %>
  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
  Back to feed
<% end %>

<%= render "posts/post", post: @post %>

<section class="mt-6">
  <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold text-muted">
    Comments
    <span id="post_<%= @post.id %>_comments_count" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300"><%= @post.comments.size %></span>
  </h2>

  <div class="mb-4">
    <%= render "comments/form", post: @post, comment: @comment %>
  </div>

  <div id="post_<%= @post.id %>_comments" class="space-y-3">
    <%= render partial: "comments/comment", collection: @post.comments %>
  </div>
</section>
